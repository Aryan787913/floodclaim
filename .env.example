# Copy this file to .env and fill in your key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=paste-your-key-here
# Check AI Studio for the newest model names (e.g. the Gemini Flash / Pro models shown there)
GEMINI_MODEL=gemini-flash-latest
GEMMA_MODEL=gemma-3-27b-it
USE_GEMMA=1
# Optional, after running scripts/setup_bigquery.py:
# BQ_TABLE=your-project-id.floodclaim.grades
